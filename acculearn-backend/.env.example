OPENAI_API_KEY=your_key_here
# Optional. Organization ADMIN key (sk-admin-...), used only to read usage and
# cost figures for the AI Usage admin page. A project key (sk-proj-...) is
# rejected with 403 by /v1/organization/usage. Create one at
# platform.openai.com -> Settings -> Organization -> Admin keys.
OPENAI_ADMIN_KEY=
MOODLE_URL=https://acculearn.online
MOODLE_TOKEN=your_moodle_webservice_token
DB_HOST=localhost
DB_NAME=moodle
DB_USER=moodleuser
DB_PASS=your_db_password
